<UserControl x:Class="Qalam.App.Views.ProjectsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Qalam.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ProjectDetailViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header and controls -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="#F1F2F6" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="18" Margin="0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding BriefSummary}" Style="{StaticResource Muted}" Margin="0,2,0,6"/>
                        <TextBlock Text="{Binding StatusDetail}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding RevisionInfo}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="Start / Resume" Command="{Binding StartCommand}"/>
                            <Button Content="Pause after this stage" Style="{StaticResource Secondary}" Command="{Binding PauseCommand}"/>
                            <Button Content="Stop now" Style="{StaticResource Secondary}" Command="{Binding StopCommand}"/>
                            <Button Content="Open in Writing Workspace" Style="{StaticResource Secondary}" Command="{Binding WorkspaceCommand}"/>
                            <Button Content="Review &amp; approve" Style="{StaticResource Success}" Command="{Binding ReviewCommand}"
                                    Visibility="{Binding CanReview, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Delete" Style="{StaticResource Danger}" Command="{Binding DeleteCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Questions from agents -->
                <Border Grid.Row="1" Style="{StaticResource Notice}" Visibility="{Binding HasQuestions, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="An agent needs your input" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding Questions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" Margin="0,1"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Multiline}"
                                 Height="80" Margin="0,8,0,8"/>
                        <WrapPanel>
                            <Button Content="Send answer and continue" Command="{Binding SendAnswerCommand}"/>
                            <Button Content="Continue without answering" Style="{StaticResource Secondary}" Command="{Binding SkipAnswerCommand}"/>
                            <Button Content="Open Brand Guidelines" Style="{StaticResource Secondary}" Command="{Binding OpenBrandCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="2" Margin="0,0,12,12">
                    <TabItem Header="Workflow">
                        <ItemsControl ItemsSource="{Binding Stages}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Agent}" Style="{StaticResource Muted}"/>
                                                <TextBlock Text="{Binding Error}" Foreground="#DC2626"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Time}" Style="{StaticResource Muted}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem Header="Outputs &amp; versions">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button Content="Copy" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Margin="0,0,0,6"
                                        Command="{Binding CopyVersionCommand}"/>
                                <TextBox Grid.Row="1" Style="{StaticResource Reader}" Text="{Binding VersionContent, Mode=OneWay}"/>
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding VersionSources}" MaxHeight="140" Margin="0,6,0,0">
                                    <ItemsControl.Template>
                                        <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkButton}" Content="{Binding Title}" ToolTip="{Binding Url}" Margin="0,1"
                                                    Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Agent messages">
                        <ListBox ItemsSource="{Binding Messages}" Margin="8" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Style="{StaticResource Muted}">
                                            <Run Text="{Binding At, Mode=OneWay}"/> · <Run Text="{Binding Type, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Route}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Summary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Task history">
                        <ListBox ItemsSource="{Binding Activity}" Margin="8" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding At}" Width="140" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,12,12">
            <Button DockPanel.Dock="Top" Content="+ New content project" Command="{Binding NewCommand}" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="12"/>
                            <TextBlock Style="{StaticResource Muted}">
                                <Run Text="{Binding Format, Mode=OneWay}"/> · <Run Text="{Binding Updated, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- New project form -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" DataContext="{Binding Form}">
                <StackPanel>
                    <TextBlock Text="New content project" Style="{StaticResource H2}" FontSize="18"/>
                    <TextBlock Style="{StaticResource Muted}" Text="Only the topic is required. Anything left blank comes from your Brand Guidelines."/>
                    <TextBlock Text="Topic or request *" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Multiline}" Height="60"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Project title (optional)" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Title}"/>
                            <TextBlock Text="Format" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{x:Static vm:NewProjectForm.Formats}" SelectedItem="{Binding Format}" DisplayMemberPath="Label" Padding="6,5"/>
                            <TextBlock Text="Word count" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding WordCount}"/>
                            <TextBlock Text="Audience (override)" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Audience}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tone" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Tone}"/>
                            <TextBlock Text="Language" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Language}"/>
                            <TextBlock Text="Publication platform" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Platform}"/>
                            <TextBlock Text="Primary keyword (optional)" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Keyword}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Notes for the team" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Notes}" Style="{StaticResource Multiline}" Height="70"/>
                    <CheckBox Content="Start the workflow immediately" IsChecked="{Binding StartNow}" Margin="0,12,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Create project" Command="{Binding DataContext.CreateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Button Content="Cancel" Style="{StaticResource Secondary}" Command="{Binding DataContext.CancelNewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <ContentControl Grid.Column="1" Content="{Binding Detail}"/>
        <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Margin="8" Text="Select a project, or create a new one."
                   Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
