<UserControl x:Class="Qalam.App.Views.SocialMediaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,10">
            <TextBlock Text="Project" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding Project}" DisplayMemberPath="Title" Width="360" Padding="6,5" Margin="0,0,12,0"/>
            <Button Content="Generate with Social Media Manager" Command="{Binding GenerateCommand}"/>
            <Button Content="Copy" Style="{StaticResource Secondary}" Command="{Binding CopyCommand}"/>
        </WrapPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Packs}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,4"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            <TextBox Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource Reader}" Text="{Binding Content, Mode=OneWay}"/>
        </Grid>
    </Grid>
</UserControl>
