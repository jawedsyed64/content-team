<UserControl x:Class="Qalam.App.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Notice}" Visibility="{Binding ShowSetupHint, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Settings" Style="{StaticResource Secondary}" Command="{Binding OpenSettingsCommand}"/>
                        <Button Content="Brand Guidelines" Style="{StaticResource Secondary}" Command="{Binding OpenBrandCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SetupHint}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="Bold" Foreground="{Binding Color}"/>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ New content project" Command="{Binding NewProjectCommand}" Margin="0"/>
                                <TextBlock Text="Needs your attention" Style="{StaticResource H2}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding NeedsAttention}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                            <Button Style="{StaticResource LinkButton}" Content="{Binding Title}"
                                                    Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Knowledge base" Style="{StaticResource H2}"/>
                            <ItemsControl ItemsSource="{Binding ContextHealth}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{Binding Color}"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Recent activity" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource Muted}">
                                            <Run Text="{Binding At, Mode=OneWay}"/> · <Run Text="{Binding Project, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
