<UserControl x:Class="Qalam.App.Views.EditorialReviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <ListBox ItemsSource="{Binding Queue}" SelectedItem="{Binding Project}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,5">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Column="1" Margin="12,0">
            <TextBlock DockPanel.Dock="Top" Text="{Binding DecisionInfo}" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Final draft" Style="{StaticResource H2}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <Button Content="Copy" Style="{StaticResource Secondary}" Command="{Binding CopyCommand}"/>
                <Button Content="Export…" Style="{StaticResource Secondary}" Command="{Binding ExportCommand}"/>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Your decision" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="Feedback is required to request changes; it is sent to the Content Writer and the draft goes through SEO, editing and QA again."/>
                    <TextBox Text="{Binding Feedback, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Multiline}" Height="70" Margin="0,8"/>
                    <WrapPanel>
                        <Button Content="Approve" Style="{StaticResource Success}" Command="{Binding ApproveCommand}"/>
                        <Button Content="Request changes" Command="{Binding RequestChangesCommand}"/>
                        <Button Content="Reject" Style="{StaticResource Danger}" Command="{Binding RejectCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBox Style="{StaticResource Reader}" Text="{Binding Draft, Mode=OneWay}"/>
        </DockPanel>

        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding QaDecisionText}" Foreground="{Binding QaDecisionColor}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding OverallScore}" FontSize="28" FontWeight="Bold"/>
                    <Border Style="{StaticResource Notice}" Margin="0,4,0,8">
                        <TextBlock Text="{Binding Disclaimer}" FontSize="12"/>
                    </Border>
                </StackPanel>
                <TabControl>
                    <TabItem Header="Scores">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Scores}" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" FontWeight="Bold" Text="{Binding Score, StringFormat='{}{0}/10'}"/>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <ProgressBar Value="{Binding Score}" Maximum="10" Height="5" Margin="0,3"/>
                                            <TextBlock Text="{Binding Explanation}" FontSize="12"/>
                                            <TextBlock Text="{Binding Recommendation, StringFormat='Improve: {0}'}" FontSize="12" Foreground="#B45309"
                                                       Visibility="{Binding IsLow, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Issues">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Issues}" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Severity, Mode=OneWay}"/> · <Run Text="{Binding Type, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Location}" FontStyle="Italic" FontSize="12"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"/>
                                            <TextBlock Text="{Binding Fix, StringFormat='Fix: {0}'}" FontSize="12" Foreground="#B45309"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Full report">
                        <TextBox Style="{StaticResource Reader}" Text="{Binding ReportText, Mode=OneWay}"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
